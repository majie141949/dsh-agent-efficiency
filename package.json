{
  "name": "dsh-agent-efficiency",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majie141949/dsh-agent-efficiency.git"
  },
  "homepage": "https://github.com/majie141949/dsh-agent-efficiency#readme",
  "bugs": {
    "url": "https://github.com/majie141949/dsh-agent-efficiency/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent",
    "efficiency"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "SEE LICENSE IN LICENSE.details",
  "description": "减少 Agent 的重复读取、整文件返工与无效重试，保留原有验证标准。",
  "type": "module",
  "main": "./dist/host/apply.js",
  "types": "./dist/host/apply.d.ts",
  "exports": {
    ".": "./dist/host/apply.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "MARKET_SUBMISSION.md",
    "LICENSE",
    "LICENSE.details",
    "benchmark-results.json",
    "fixtures",
    "scripts"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "catalog:types",
    "typescript": "catalog:cli",
    "vitest": "catalog:testing"
  }
}
